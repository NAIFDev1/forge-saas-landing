  "narrative": {
    "northStar": "The well-kept release board",
    "overview": "Forge presents a developer workflow as fitted working cells: warm putty surrounds quiet paper surfaces, charcoal consoles, and purposeful petrol actions. Large plainspoken type gives the page confidence; compact interface details supply the evidence.\n\nThe system treats the product demonstration as real interface work. A tinted frame holds an inset application sheet, with readable release records, visible control states, and honest local feedback. Typography and authored SVG carry the identity; no raster imagery is needed.",
    "keyCharacteristics": [
      "Warm neutral fields and charcoal working panels.",
      "Square page cells with narrow seams.",
      "One self-hosted sans family, with monospace confined to literal code.",
      "An inset rounded application sheet inside a square frame.",
      "Visible, keyboard-operable product evidence."
    ],
    "rules": [
      {
        "name": "The Working Color Rule",
        "body": "Accent and status colors identify actions, selected content, or release state; maintain text or icon cues alongside status color.",
        "section": "colors"
      },
      {
        "name": "The One Reading Voice Rule",
        "body": "Use Switzer for interface and editorial text; reserve monospace for literal code, commands, and identifiers.",
        "section": "typography"
      },
      {
        "name": "The Fitted Field Rule",
        "body": "Separate page content with filled tonal fields and narrow seams; reserve fine rules for native application data and tabs.",
        "section": "layout"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Build permanent hierarchy with adjacent tones; use a shadow for the floating menu overlay.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve fitted tonal cells, narrow seams, and generous section intervals.",
      "**Do** use the inset sheet as the rounded application exception.",
      "**Do** keep status labels, visible focus, keyboard controls, and reduced-motion support.",
      "**Do** reflow real interface content into readable mobile rows.",
      "**Do** label illustrative deployments, code, and plans honestly."
    ],
    "donts": [
      "**Don't** introduce a different display family into the established Switzer system.",
      "**Don't** apply resting shadows or rounded card styling across the square page cells.",
      "**Don't** replace operative product fragments with decorative raster screenshots.",
      "**Don't** reuse historical `src/index.css` tokens; `src/main.jsx` imports `src/forge.css`."
    ]
  }
}
