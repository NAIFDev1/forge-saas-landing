      "css": ".ds-tabs{display:flex;gap:24px;border-bottom:1px solid var(--rule,#dcded8);font:13px Switzer,sans-serif}.ds-tabs button{min-height:44px;padding:10px 0;border:0;background:none;color:var(--muted,#50554e);font:inherit;position:relative;cursor:pointer}.ds-tabs button:hover{color:var(--ink,#202522)}.ds-tabs button[aria-selected=true]{color:var(--ink,#202522)}.ds-tabs button[aria-selected=true]:after{content:\"\";position:absolute;bottom:-1px;left:0;right:0;height:2px;background:var(--accent,#256f82)}.ds-tabs button:focus-visible{outline:3px solid var(--success-light,#a5d0b7);outline-offset:5px}"
